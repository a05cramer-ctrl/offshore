{
  "crons": [{ "path": "/api/burn", "schedule": "0 12 * * *" }],
  "functions": {
    "api/burn.js": { "maxDuration": 60 },
    "api/bags.js": { "maxDuration": 20 },
    "api/rpc.js": { "maxDuration": 25 },
    "api/stats.js": { "maxDuration": 15 }
  },
  "headers": [
    { "source": "/js/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }] },
    { "source": "/api/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ]
}
